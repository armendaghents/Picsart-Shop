# PostgreSQL connection string. Anything libpq understands works — a local
# server, a socket, or a hosted database (append ?sslmode=require for those).
DATABASE_URL=postgres://localhost:5432/atlas

# ---------------------------------------------------------------------------
# Admin console at /admin
#
# Generate the two values below with:  node scripts/admin-credentials.mjs
# ---------------------------------------------------------------------------

# Named admin accounts. With two or more admins, list them here and give each
# their own hash and authenticator secret — the log then names who signed in,
# removing one person leaves the other untouched, and one admin's typos cannot
# lock the other out. Generate each with:
#   node scripts/admin-credentials.mjs --user anna
#
#   ADMIN_USERS=anna,bob
#   ADMIN_ANNA_PASSWORD_HASH=scrypt$16384$8$1$...
#   ADMIN_ANNA_TOTP_SECRET=...
#   ADMIN_BOB_PASSWORD_HASH=scrypt$16384$8$1$...
#   ADMIN_BOB_TOTP_SECRET=...
#
# Leave ADMIN_USERS empty to keep the single shared login below, which asks for
# no username. The two modes are exclusive: with ADMIN_USERS set, the shared
# ADMIN_PASSWORD_HASH / ADMIN_TOTP_SECRET are ignored.
ADMIN_USERS=

# scrypt hash of the admin password. Preferred over ADMIN_PASSWORD: the clear
# password then exists nowhere on the server, so a leaked .env, a backup or a
# shoulder-surfed terminal does not hand over the console.
ADMIN_PASSWORD_HASH=

# Fallback for development only. If ADMIN_PASSWORD_HASH is empty this is hashed
# at boot and removed from the environment. The server refuses to start with
# this unset (or left as 'changeme') when NODE_ENV=production.
# ADMIN_PASSWORD=pick-something-only-you-know

# Base32 secret for an authenticator app (Google Authenticator, 1Password,
# Authy). When set, admin login asks for a six-digit code as well as the
# password — which is what stops a stolen or guessed password from being enough
# on its own. Strongly recommended in production.
ADMIN_TOTP_SECRET=

# Comma-separated addresses or IPv4 CIDR ranges allowed to reach /admin and the
# admin API. Everything else gets a 404 before authentication even runs. Leave
# empty to allow any address; set it to your office or VPN range and remote
# password guessing stops being possible at all.
#   ADMIN_IP_ALLOWLIST=203.0.113.4,10.8.0.0/24
ADMIN_IP_ALLOWLIST=

# Admin sessions are tied to the network they were created on (IPv4 /24, IPv6
# /64, all loopback counted as one) as well as the browser, so a cookie copied
# to another network is refused. Set this to "off" if your admins roam between
# networks mid-session and the re-logins are more trouble than the protection
# is worth; the browser pin stays either way.
# ADMIN_PIN_SESSION_NETWORK=on

# Number of reverse proxies in front of this server (nginx, Cloudflare, a load
# balancer). Required for the rate limits, the lockout and ADMIN_IP_ALLOWLIST to
# see the real client address instead of the proxy's — and to stop a client
# forging X-Forwarded-For. Leave unset when nothing is in front.
# TRUST_PROXY=1

# Signing key for customer access tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If this is unset a random key is generated at startup, which signs every
# customer out whenever the server restarts.
AUTH_SECRET=replace-with-a-long-random-string

# Optional — the port the app listens on (default 3000).
# PORT=3000

# Sign in with Google (optional). When both are set, the storefront offers a
# "Continue with Google" button alongside the email and password form.
#
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# (type: Web application) and add this exact Authorised redirect URI:
#   http://localhost:3000/api/auth/google/callback
# In production use your real origin, and set PUBLIC_URL to match so the
# redirect URI is built correctly behind a proxy.
#
# Accounts created this way are verified by Google and have no password, so they
# never need a verification code or a reset email.
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret
# PUBLIC_URL=https://shop.example.com

# Email delivery for verification codes, password resets, and security notices.
# Leave SMTP_HOST unset in development and those messages are printed to the
# server log instead of being sent, so the flows still work end to end.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASSWORD=your-smtp-password
# MAIL_FROM=Picsart Shop <no-reply@your-domain.com>
