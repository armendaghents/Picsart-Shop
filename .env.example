# PostgreSQL connection string. Anything libpq understands works — a local
# server, a socket, or a hosted database (append ?sslmode=require for those).
DATABASE_URL=postgres://localhost:5432/atlas

# Password for the admin console at /admin.
ADMIN_PASSWORD=pick-something-only-you-know

# Signing key for customer access tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If this is unset a random key is generated at startup, which signs every
# customer out whenever the server restarts.
AUTH_SECRET=replace-with-a-long-random-string

# Optional — the port the app listens on (default 3000).
# PORT=3000

# Email delivery for verification codes, password resets, and security notices.
# Leave SMTP_HOST unset in development and those messages are printed to the
# server log instead of being sent, so the flows still work end to end.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASSWORD=your-smtp-password
# MAIL_FROM=Picsart Shop <no-reply@your-domain.com>
